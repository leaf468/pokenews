# Pokemon Cards Threads Bot - Environment Variables
# Copy this file to .env and fill in your API keys

# Required: OpenAI API (content generation + web search)
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-xxxxx

# Optional: override the default model (default: gpt-5-mini)
OPENAI_MODEL=gpt-5-mini

# Optional: X API v2 recent search (paid plan)
X_BEARER_TOKEN=

# Optional: our own Threads handle, excluded from Threads keyword search results
THREADS_USERNAME=

# Optional: Instagram Graph API (business_discovery) — your own business/creator account's token
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCOUNTS=pokemon_korea pokemoncardgame_korea

# GitHub Token (automatically provided by GitHub Actions, no need to set)
GITHUB_TOKEN=ghp_xxxxx

# ========================================
# Threads Auto-Posting
# ========================================
# 값이 없으면 게시를 건너뛰고 텍스트 파일만 reports/ 에 생성합니다.

# Meta Threads API
# Get your keys at: https://developers.facebook.com/docs/threads
THREADS_ACCESS_TOKEN=your_threads_access_token
THREADS_USER_ID=your_threads_user_id
